# using PAT
#export GITHUB_TOKEN=xxxxxxxxxxxx

# or GitHub App
#export GITHUB_APP_PEM_PATH=/path/to/github_app.pem
#export GITHUB_APP_ID=123

# recommended using --dangerously-skip-permissions, and you can add any other args
export CLAUDE_ARGS="--dangerously-skip-permissions"

# External session manager allocator mode (External Session Manager -> 親プロキシ outbound polling)
# Route ESM session traffic directly from each Session Pod to the parent proxy.
# Requires SESSION_CONTROL_LONG_POLL_ENABLED=true and Redis.
AGENTAPI_DIRECT_SESSION_RUNTIME_ENABLED=false
#export SESSION_MANAGER_UPSTREAM_URL=https://parent-proxy.example.com
#export SESSION_MANAGER_CONNECTION_TOKEN=generated-token-from-parent-proxy-settings
