{
  "name": "agentapi-ui",
  "version": "v1.19.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "next dev",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=1 NEXT_TELEMETRY_DISABLED=1 next build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "size:cloudflare": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "docs:init": "cd docs && honkit init",
    "docs:serve": "cd docs && honkit serve",
    "docs:build": "cd docs && honkit build"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.5.0",
    "lucide-react": "^0.525.0",
    "next": "15.4.10",
    "next-pwa": "^5.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.7",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.2",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/experimental-ct-react": "^1.53.2",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-window": "^2.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001809",
    "eslint": "^8",
    "eslint-config-next": "15.4.10",
    "happy-dom": "^18.0.1",
    "honkit": "^6.1.4",
    "jsdom": "^25.0.1",
    "msw": "2.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0"
  }
}
