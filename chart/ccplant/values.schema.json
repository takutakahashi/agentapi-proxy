{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": ["hostname", "apiHostname", "ingress"],
      "additionalProperties": true,
      "properties": {
        "hostname": { "type": "string", "minLength": 1 },
        "apiHostname": { "type": "string", "minLength": 1 },
        "ingress": {
          "type": "object",
          "required": ["className", "tls"],
          "properties": {
            "className": { "type": "string" },
            "tls": {
              "type": "object",
              "required": ["enabled"],
              "properties": { "enabled": { "type": "boolean" } }
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
